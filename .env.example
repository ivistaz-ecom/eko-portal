# eKO Portal frontend settings. Copy to .env.local (dev) or .env.production.
# The email domain, Azure keys and timeouts live in backend/.env (single source of truth).

# Where the Next.js server reaches FastAPI (server-to-server, not exposed to browsers)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# Must match SESSION_COOKIE_NAME in backend/.env
SESSION_COOKIE_NAME=eko_session

# Branding & help links shown on the sign-in page
NEXT_PUBLIC_LOGO_URL=https://www.hccb.in/assets/imgs/logo-new.png
NEXT_PUBLIC_PASSWORD_RESET_URL=https://passwordreset.microsoftonline.com/
NEXT_PUBLIC_HELPDESK_URL=mailto:itservicedesk@changingtree.in
